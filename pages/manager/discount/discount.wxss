page {
  background-color: #f7f8fa;
}

.container {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-height: 100vh;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}


/* ==============================
   固定 Header
   ============================== */

.discount-header {
  position: fixed;
  top: 0;
  left: 0;

  width: 100%;

  background-color: #f7f8fa;

  z-index: 1000;

  box-sizing: border-box;
}


/* ==============================
   顶部 Tab
   ============================== */

.tab-header {
  display: flex;

  background-color: #ffffff;

  width: 100%;
  height: 96rpx;

  align-items: center;
  justify-content: space-between;

  box-sizing: border-box;
}

.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  box-sizing: border-box;
}

.tab-text {
  font-size: 30rpx;
  color: #666666;
  transition: color 0.2s ease;
}

.tab-item.active .tab-text {
  color: #00c261;
  font-weight: bold;
}

.active-line {
  position: absolute;
  bottom: 0;

  width: 60rpx;
  height: 6rpx;
  background-color: #00c261;

  border-radius: 3rpx;
}


/* ==============================
   添加按钮区域
   ============================== */

.action-bar {
  width: 100%;
  padding: 30rpx 40rpx 15rpx;
  box-sizing: border-box;
  background-color: #f7f8fa;
}

.add-btn {
  background-color: #00c261;
  color: #ffffff;
  border-radius: 50rpx;
  width: 100%;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 6rpx 16rpx rgba(0, 194, 97, 0.25);
  border: none;
}

.add-btn-hover {
  background-color: #00a852;

  transform: translateY(2rpx);
}

.add-btn::after {
  border: none;
}

.add-btn .icon {
  font-size: 40rpx;

  margin-right: 12rpx;
  margin-top: -6rpx;
}


/* ==============================
   折扣列表
   ============================== */

.discount-list {
  display: flex;
  flex-direction: column;

  width: 100%;
  padding: 40rpx 40rpx 15rpx;

  box-sizing: border-box;
}


/* ==============================
   折扣卡片
   ============================== */
/* ========================
   折扣卡片
======================== */

.discount-card {
  margin: 24rpx 30rpx;
  padding: 30rpx;

  background: #ffffff;

  border-radius: 24rpx;

  box-shadow:
    0 4rpx 12rpx rgba(0, 0, 0, 0.03),
    0 10rpx 30rpx rgba(0, 0, 0, 0.04);

  box-sizing: border-box;
}


/* ========================
   卡片主体
======================== */

.card-main {
  display: flex;
  align-items: center;
}


/* 左侧折扣图标 */

.discount-icon {
  width: 92rpx;
  height: 92rpx;

  flex-shrink: 0;

  border-radius: 24rpx;

  background: linear-gradient(
    135deg,
    #ff9866,
    #ff6b55
  );

  display: flex;
  align-items: center;
  justify-content: center;

  margin-right: 24rpx;

  box-shadow: 0 8rpx 18rpx rgba(255, 107, 85, 0.18);
}


.discount-icon-text {
  color: #ffffff;

  font-size: 42rpx;
  font-weight: 700;
}


/* ========================
   折扣信息
======================== */

.card-info {
  flex: 1;

  min-width: 0;
}


/* 标题区域 */

.title-row {
  display: flex;
  align-items: center;

  margin-bottom: 16rpx;
}


.title {
  flex: 1;

  font-size: 32rpx;
  font-weight: 600;

  color: #252525;

  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}


/* 状态 */

.status-tag {
  flex-shrink: 0;

  margin-left: 16rpx;

  padding: 6rpx 14rpx;

  border-radius: 20rpx;

  background: #effaf1;

  color: #45a85a;

  font-size: 21rpx;
}


/* ========================
   折扣类型
======================== */

.type-row {
  display: flex;
  align-items: center;
}


.discount-type {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  padding: 7rpx 18rpx;

  border-radius: 20rpx;

  background: #fff3ed;

  color: #f27648;

  font-size: 23rpx;
}


/* ========================
   分割线
======================== */

.card-divider {
  height: 1rpx;

  background: #f1f1f1;

  margin: 28rpx 0 22rpx;
}


/* ========================
   底部
======================== */

/* ========================
   卡片底部
======================== */

.card-footer {
  display: flex;
  flex-direction: column;

  width: 100%;
}


/* ========================
   有效日期
======================== */

.valid-date {
  width: 100%;

  display: flex;
  align-items: flex-start;

  box-sizing: border-box;
}


.date-icon {
  flex-shrink: 0;

  margin-right: 12rpx;
  margin-top: 3rpx;

  color: #aaaaaa;
  font-size: 27rpx;
}


/* 日期右侧内容 */
.date-content {
  flex: 1;

  display: flex;
  flex-direction: column;

  min-width: 0;
}


.date-label {
  font-size: 22rpx;

  color: #aaaaaa;

  margin-bottom: 8rpx;
}


/* 日期本体 */
.date-text {
  width: 100%;

  font-size: 24rpx;

  color: #666666;

  line-height: 1.6;

  /* 允许完整显示 */
  white-space: normal;
  word-break: break-all;
}


/* ========================
   按钮区域
======================== */

.footer-actions {
  width: 100%;

  display: flex;
  justify-content: flex-end;
  align-items: center;

  margin-top: 22rpx;
}


/* ========================
   下架按钮
======================== */

.off-btn {
  height: 58rpx;

  padding: 0 26rpx;

  border-radius: 29rpx;

  background: #fff4f4;

  border: 1rpx solid #ffdada;

  color: #e75b5b;

  font-size: 24rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  box-sizing: border-box;
}


.off-btn-hover {
  background: #ffe6e6;

  transform: scale(0.96);
}
/* ========================
   删除按钮
======================== */

.delete-btn {
  height: 58rpx;

  padding: 0 26rpx;

  border-radius: 29rpx;

  background: #fff4f4;

  border: 1rpx solid #ffdada;

  color: #e75b5b;

  font-size: 24rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  box-sizing: border-box;
}

.delete-btn-hover {
  background: #ffe6e6;
  transform: scale(0.96);
}
/* 遮罩层 */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  align-items: flex-end;
  z-index: 1000;

  /* 关键：默认完全不渲染，防止真机首帧闪内容 */
  display: none;
}

/* 打开时再显示 */
.dialog-mask.show {
  display: flex;
  animation: dialogMaskFadeIn 0.25s ease;
}

.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  align-items: flex-end;
  z-index: 1000;

  /* 关键：默认完全不渲染，防止真机首帧闪内容 */
  display: none;
}

/* 打开时再显示 */
.dialog-mask.show {
  display: flex;
  animation: dialogMaskFadeIn 0.25s ease;
}

/* 弹窗主体 */
.dialog-container {
  width: 100%;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 0;

  /* 默认状态 */
  transform: translateY(100%);
}

/* 打开时播放上滑动画 */
.dialog-mask.show .dialog-container {
  animation: dialogSlideUp 0.3s ease forwards;
}

@keyframes dialogMaskFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes dialogSlideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.dialog-header {
  padding: 0 40rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.dialog-title { font-size: 34rpx; font-weight: bold; }
.close-icon { color: #ccc; font-size: 40rpx; padding: 10rpx; }

.dialog-content {
  max-height: 70vh;
  padding: 0 40rpx;
}

/* 表单项样式 */
.form-item { margin-bottom: 30rpx; }
.form-row { display: flex; justify-content: space-between; }
.form-item.half { width: 48%; }

.form-label {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}
.input-placeholder {
  font-size: 24rpx;
  color: #999;
}
.form-input {
  background: #f7f8fa;
  height: 90rpx;
  border-radius: 16rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;   /* 垂直居中 */
}
.picker-input { line-height: 90rpx; color: #999; }

/* 上传框 */
.upload-box {
  width:200rpx;
  height:200rpx;
  border:2rpx dashed #ccc;

  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;

  position:relative;
  overflow:hidden;
}
.upload-image{
  width:100%;
  height:100%;
}
.upload-plus { font-size: 50rpx; color: #999; margin-bottom: 6rpx; }
.upload-tip { font-size: 20rpx; color: #999; }

/* 底部按钮 */
.dialog-footer {
  padding: 40rpx;
  display: flex;
  justify-content: space-between;
}
.btn-cancel {
  width: 30%;
  background: #f5f5f5;
  color: #666;
  border-radius: 45rpx;
  font-size: 28rpx;
}
.btn-confirm {
  width: 65%;
  background: #07c160; /* 统一样式颜色 */
  color: #fff;
  border-radius: 45rpx;
  font-size: 28rpx;
}

/* 日期选择框 */
.picker-box {
  width: 100%;
  height: 90rpx;

  padding: 0 28rpx;

  background: #f7f8fa;

  border: 2rpx solid transparent;
  border-radius: 16rpx;

  display: flex;
  align-items: center;
  justify-content: space-between;

  box-sizing: border-box;

  transition: all 0.2s;
}


/* 左侧 */
.picker-left {
  flex: 1;

  display: flex;
  align-items: center;

  min-width: 0;
}


/* 日期图标 */
.picker-icon {
  flex-shrink: 0;

  margin-right: 18rpx;

  font-size: 30rpx;

  color: #aaaaaa;
}


/* 默认文字 */
.picker-text {
  font-size: 28rpx;
  text-align: center;
  color: #aaaaaa;
}


/* 已选择日期 */
.picker-selected .picker-text {
  color: #333333;
}


/* 右侧箭头 */
.picker-arrow {
  flex-shrink: 0;

  margin-left: 20rpx;

  color: #b5b5b5;

  font-size: 40rpx;

  line-height: 1;
}

.hidden{
  display: none;
}

/* 遮罩 */
.ts-del-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

/* 弹窗 */
.ts-del-dialog {
  width: 70%;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx 20rpx;
  box-sizing: border-box;
}

/* 文案 */
.ts-del-text {
  text-align: center;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 30rpx;
}

/* 按钮区域 */
.ts-del-actions {
  display: flex;
  border-top: 1rpx solid #eee;
}

/* 按钮通用 */
.ts-del-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
}

/* 取消 */
.ts-del-btn.cancel {
  color: #999;
  border-right: 1rpx solid #eee;
}

/* 删除（危险操作） */
.ts-del-btn.confirm {
  color: #ff4d4f;
  font-weight: 500;
}